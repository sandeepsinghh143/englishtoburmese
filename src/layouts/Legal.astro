---
import Layout from './Layout.astro';

interface Props {
  title: string;
  heading: string;
  updated: string;
  description: string;
  current?: string;
  path?: string;
  keywords?: string;
}

const { title, heading, updated, description, current = '', path = '/', keywords } = Astro.props;

const pageName = heading;
const breadcrumbs = [
  { name: pageName, path },
];
---

<Layout
  title={title}
  description={description}
  current={current}
  path={path}
  type="article"
  keywords={keywords}
  breadcrumbs={breadcrumbs}
>
  <article class="legal">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/">
            <span itemprop="name">Home</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li aria-hidden="true" class="crumb-separator">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
          <span itemprop="name">{heading}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </nav>

    <p class="legal-kicker">englishtoburmese.com</p>
    <h1>{heading}</h1>
    <p class="legal-meta">Last updated: {updated}</p>
    <div class="legal-body">
      <slot />
    </div>

    <div class="legal-nav-back">
      <a href="/" class="btn-back">← Back to English to Burmese Translator</a>
    </div>
  </article>
</Layout>
