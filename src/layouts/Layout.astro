---
import '../styles/global.css';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description?: string;
  current?: string;
  path?: string;
  type?: 'website' | 'article';
  keywords?: string;
  breadcrumbs?: BreadcrumbItem[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const SITE = 'https://englishtoburmese.com';
const DEFAULT_DESCRIPTION =
  'Free English to Burmese translator online. Translate English to Burmese text, sentences, documents, and audio into Unicode Myanmar script.';
const DEFAULT_KEYWORDS = [
  'english to burmese',
  'translate english to burmese',
  'english to burmese translation',
  'google translate english to burmese',
  'english to burmese translator',
  'english to burmese translate',
  'translate english to burmese audio',
  'translate to english to burmese',
  'translation english to burmese',
  'translate from english to burmese',
  'english to burmese language translation',
  'english to burmese translation audio',
  'english to burmese translation sentences',
  'translate english to burmese language',
  'translate english to burmese google translate',
  'english to burmese translation online',
  'english to burmese google translate',
].join(', ');

const {
  title,
  description = DEFAULT_DESCRIPTION,
  current = '',
  path = '/',
  type = 'website',
  keywords = DEFAULT_KEYWORDS,
  breadcrumbs,
  jsonLd,
} = Astro.props;

const canonical = new URL(path, SITE).toString();
const ogImage = `${SITE}/og.png`;
const year = new Date().getFullYear();
const nav = [
  { href: '/', label: 'Translator', key: 'home' },
  { href: '/blog', label: 'Blog', key: 'blog' },
  { href: '/about', label: 'About', key: 'about' },
  { href: '/contact', label: 'Contact', key: 'contact' },
];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'englishtoburmese.com',
  url: SITE,
  logo: `${SITE}/logo.png`,
  description: DEFAULT_DESCRIPTION,
};

const breadcrumbSchema =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: SITE,
          },
          ...breadcrumbs.map((b, idx) => ({
            '@type': 'ListItem',
            position: idx + 2,
            name: b.name,
            item: new URL(b.path, SITE).toString(),
          })),
        ],
      }
    : null;

const schema = [
  organization,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-67CW9VVRYL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-67CW9VVRYL');
    </script>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#4a1520" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="englishtoburmese.com" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="my" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="help" type="text/plain" href="/llms.txt" title="LLM Information" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="englishtoburmese.com" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="my_MM" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="English to Burmese translator — translate English to Burmese online" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="English to Burmese translator online" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,750&family=Noto+Sans+Myanmar:wght@400;600;700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" />

    {schema.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <div class="site">
      <header class="site-header">
        <div class="site-header-inner">
          <a class="logo" href="/" aria-label="englishtoburmese.com Homepage">
            <img class="logo-mark" src="/logo.png" width="42" height="42" alt="englishtoburmese.com logo" />
            <span class="logo-text">
              <span class="logo-name">englishtoburmese.com</span>
              <span class="logo-tag">English to Burmese</span>
            </span>
          </a>
          <nav class="site-nav" aria-label="Primary navigation">
            {nav.map((item) => (
              <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </header>

      <main class="page">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer-inner">
          <div class="footer-brand">
            <p class="footer-title">englishtoburmese.com</p>
            <p>Free English to Burmese translator for text, speech, and documents. Translate English to Burmese online in Unicode Myanmar script.</p>
          </div>
          <div class="footer-cols">
            <div>
              <h2>Translate</h2>
              <a href="/">English to Burmese</a>
              <a href="/#file">Translate documents</a>
              <a href="/#why">Why use this tool</a>
              <a href="/#compare">Comparison</a>
              <a href="/#faq">FAQ</a>
            </div>
            <div>
              <h2>Company</h2>
              <a href="/blog">Blog</a>
              <a href="/about">About</a>
              <a href="/contact">Contact us</a>
              <a href="/sitemap.xml">XML Sitemap</a>
              <a href="/llms.txt">LLMs Context</a>
            </div>
            <div>
              <h2>Legal</h2>
              <a href="/terms">Terms and Conditions</a>
              <a href="/disclaimer">Disclaimer</a>
              <a href="/privacy">Privacy Policy</a>
            </div>
          </div>
        </div>
        <p class="footer-copy">© {year} englishtoburmese.com. English to Burmese translation online. All rights reserved.</p>
      </footer>
    </div>
  </body>
</html>
