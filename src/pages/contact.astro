---
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [
  { name: 'Contact us', path: '/contact' },
];
---

<Layout
  title="Contact Us | English to Burmese Translation Support"
  description="Contact englishtoburmese.com for help with English to Burmese translation online, voice audio issues, or document translation feedback."
  current="contact"
  path="/contact"
  breadcrumbs={breadcrumbs}
>
  <article class="legal">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/">
            <span itemprop="name">Home</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li aria-hidden="true" class="crumb-separator">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
          <span itemprop="name">Contact us</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </nav>

    <p class="legal-kicker">englishtoburmese.com</p>
    <h1>Contact us</h1>
    <p class="legal-meta">We usually reply within a few business days.</p>
    <div class="legal-body">
      <p>
        Use this form for questions, translation feedback, or website issues. If you have questions about machine translation accuracy, please review our <a href="/disclaimer">Disclaimer</a> or browse the <a href="/#faq">frequently asked questions</a>.
      </p>
      <p>
        Email: <a href="mailto:hello@englishtoburmese.com">hello@englishtoburmese.com</a>
      </p>
      <form class="contact-form" id="contact-form">
        <div>
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required maxlength="120" autocomplete="name" />
        </div>
        <div>
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required maxlength="160" autocomplete="email" />
        </div>
        <div>
          <label for="subject">Subject</label>
          <input id="subject" name="subject" type="text" required maxlength="160" />
        </div>
        <div>
          <label for="message">Message</label>
          <textarea id="message" name="message" required maxlength="4000"></textarea>
        </div>
        <div class="row">
          <button class="primary" type="submit">Send message</button>
          <span class="status" id="contact-status"></span>
        </div>
      </form>

      <h2>Frequently asked topics</h2>
      <p>
        Looking for immediate help? You can check our <a href="/about">About page</a> to understand how our tool works, read our <a href="/privacy">Privacy Policy</a> to see how we treat uploaded files, or return to our <a href="/">English to Burmese translator</a> to run a new translation.
      </p>
    </div>

    <div class="legal-nav-back">
      <a href="/" class="btn-back">← Back to English to Burmese Translator</a>
    </div>
  </article>
  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('contact-status')!;
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const subject = String(data.get('subject') || '').trim();
      const message = String(data.get('message') || '').trim();
      const body = `Name: ${name}\nEmail: ${email}\n\n${message}`;
      window.location.href = `mailto:hello@englishtoburmese.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      status.textContent = 'Opening your email app...';
      status.className = 'status ok';
    });
  </script>
</Layout>
